<!-- IchthysOS: which line is which ear, under each chart. The charts used to rely on the reader
     knowing the blue-left / red-right audiogram convention. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/dot_left"
        android:importantForAccessibility="no" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ear_left_title"
        style="@style/LegendLabel" />

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/dot_right"
        android:importantForAccessibility="no" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ear_right_title"
        style="@style/LegendLabel" />
</LinearLayout>
